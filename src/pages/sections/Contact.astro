<section id="contact">
  <div class="section-container pt-0">

    <div class="glass-panel grid gap-12 md:grid-cols-2 md:p-12">

      <div>
        <p class="mb-3 text-sm font-bold uppercase tracking-[.2em] text-emerald-700 dark:text-emerald-300">
          Let's Connect
        </p>

        <h2 class="section-title">
          Have a project in mind?
        </h2>

        <p class="section-description">
          I'd love to hear about your ideas, collaborations,
          or opportunities. Feel free to send me a message!
        </p>

        <div class="mt-8 space-y-5">
          <p>✉ <span class="ml-2">guiandumagat18@gmail.com</span></p>
          <p>♡ <span class="ml-2">Let's create something meaningful.</span></p>
        </div>
      </div>

      <form id="contactForm" class="space-y-5">

        <div>
          <label for="name" class="mb-2 block text-sm font-bold">
            Your Name
          </label>

          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="Enter your name"
            class="w-full rounded-xl border border-stone-400/40 bg-white/70 px-4 py-3 text-stone-900 outline-none focus:ring-2 focus:ring-emerald-500"
          />
        </div>

        <div>
          <label for="email" class="mb-2 block text-sm font-bold">
            Email Address
          </label>

          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="you@example.com"
            class="w-full rounded-xl border border-stone-400/40 bg-white/70 px-4 py-3 text-stone-900 outline-none focus:ring-2 focus:ring-emerald-500"
          />
        </div>

        <div>
          <label for="message" class="mb-2 block text-sm font-bold">
            Message
          </label>

          <textarea
            id="message"
            name="message"
            rows="5"
            required
            placeholder="Tell me about your idea..."
            class="w-full rounded-xl border border-stone-400/40 bg-white/70 px-4 py-3 text-stone-900 outline-none focus:ring-2 focus:ring-emerald-500"
          ></textarea>
        </div>

        <button type="submit" class="primary-button w-full">
          Send Message ↗
        </button>

        <p
          id="formNotice"
          class="hidden text-sm text-emerald-600"
          role="status"
          aria-live="polite"
        ></p>

      </form>
    </div>
  </div>
</section>
